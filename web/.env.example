# Copy to .env and adjust. Used by docker-compose.web.yml.

# Host/IP of the machine running the Duix backend containers (TTS + gen-video).
DUIX_SERVER_HOST=192.168.1.100

# Host path that the backend containers mount as their data volume.
#   Windows backend: d:/duix_avatar_data   (use a path Docker can access)
#   Linux backend:   /path/to/duix_avatar_data
DUIX_DATA_DIR=/data/duix_avatar_data

# Port the web UI is published on.
WEB_PORT=8080
